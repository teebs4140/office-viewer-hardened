{
  "name": "office-viewer-hardened",
  "displayName": "Office Viewer (Hardened Fork)",
  "description": "Hardened fork of Office Viewer 4.2.0 that views CSV/TSV, Excel (.xlsx/.xlsm), Word (.docx/.dotx) and PDF files inside VS Code.",
  "version": "1.0.0",
  "publisher": "dcri-biostats",
  "license": "MIT",
  "icon": "image/logo.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "keywords": [
    "pdf",
    "word",
    "docx",
    "excel",
    "xlsx",
    "csv",
    "tsv",
    "viewer"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/teebs4140/office-viewer-hardened/issues"
  },
  "homepage": "https://github.com/teebs4140/office-viewer-hardened",
  "repository": {
    "type": "git",
    "url": "https://github.com/teebs4140/office-viewer-hardened.git"
  },
  "main": "./out/extension.js",
  "scripts": {
    "dev": "vite --mode=development",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "build": "vite build --mode=production",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "less": "^4.2.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.5",
    "@cweijan/exceljs": "^5.0.2",
    "@eigenpal/docx-editor-react": "^1.9.0",
    "@vscode/codicons": "^0.0.45",
    "antd": "^5.15.4",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "udsv": "^0.5.3"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "officeViewerHardened.viewer",
        "displayName": "Office Viewer (Hardened)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.dotx"
          },
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ]
  }
}
